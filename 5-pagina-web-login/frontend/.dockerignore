src/**/*.test.jsx
src/**/*.spec.js
src/**/*.spec.jsx
__tests__/
tests/

# Ignorar archivos de desarrollo
.vscode/
.idea/
*.swp
*.swo
*~

# Ignorar documentación
*.md
docs/

# Ignorar archivos de Git
.git/
.gitignore
.gitattributes

# Ignorar archivos temporales
tmp/
temp/
*.tmp
*.log

# Ignorar archivos de CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Ignorar archivos de Docker
Dockerfile
.dockerignore
docker-compose*.yml

